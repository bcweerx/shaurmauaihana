# Server only. Never prefix secrets with VITE_. Never commit .env.local.
ORDERS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret, at least 32 characters, to HMAC IPs and order fingerprints.
ORDER_HASH_SECRET=
# Exact origins, comma separated. No wildcard, trailing slash or path.
ORDER_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Build-time HTTPS origin. Leave empty until a domain is confirmed.
SITE_URL=
# Also requires ownerVerified/indexable and VERCEL_ENV=production.
SEO_INDEXING_ENABLED=false
